# ========================
# Metrobüs Akıllı Trafik Yönetim Sistemi
# Ortam Değişkenleri
# ========================

# Genel
NODE_ENV=development
LOG_LEVEL=debug

# Veritabanı (TimescaleDB / PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=metrobus
DB_USER=metrobus_user
DB_PASSWORD=your_secure_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=metrobus-system
KAFKA_GROUP_ID=metrobus-consumers

# API Gateway
API_PORT=3000
API_HOST=0.0.0.0
API_CORS_ORIGIN=http://localhost:5173

# WebSocket
WS_PORT=3001
WS_PATH=/ws

# İETT / İBB API
IETT_API_BASE_URL=https://api.ibb.gov.tr
IETT_API_KEY=your_iett_api_key_here

# Trafik API (Google Maps veya Yandex)
TRAFFIC_API_PROVIDER=google
TRAFFIC_API_KEY=your_traffic_api_key_here

# ML Servis
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_PORT=8000

# Karar Motoru Parametreleri
HEADWAY_MIN_SECONDS=60
HEADWAY_MAX_SECONDS=300
BUNCHING_THRESHOLD_METERS=200
CONGESTION_SCORE_THRESHOLD=80
SPEED_ADJUSTMENT_FACTOR=0.30

# Şoför HUD
HUD_PORT=5173
HUD_REFRESH_INTERVAL_MS=2000

# Dashboard
DASHBOARD_PORT=5174
