# ========================================
# Python Servisler (sim_server + live_server)
# ========================================
FROM python:3.11-slim AS python-base

WORKDIR /app

# Python bağımlılıkları
RUN pip install --no-cache-dir websockets numpy requests

# Proje dosyalarını kopyala
COPY rl_env/ rl_env/
COPY sim_server.py .
COPY packages/shared/src/constants/platform-entries.ts packages/shared/src/constants/platform-entries.ts

# ========================================
# Stage: Sim Server
# ========================================
FROM python-base AS sim-server
EXPOSE 8765
CMD ["python", "-u", "sim_server.py"]
