// ===================================================================
//  Metrobus Karar Motoru — Kosullu Karar Agaci
//  Render (PDF, LaTeX \includegraphics icin vektörel):
//      dot -Tpdf karar_agaci.dot -o karar_agaci.pdf
//  Onizleme PNG:
//      dot -Tpng -Gdpi=200 karar_agaci.dot -o karar_agaci.png
//  Native LaTeX/TikZ (matematik dizgisi icin):
//      dot2tex --texmode=math -ftikz karar_agaci.dot > karar_agaci.tex
// ===================================================================
digraph KararAgaci {
    rankdir=TB;
    bgcolor="white";
    splines=polyline;
    nodesep=0.5;
    ranksep=0.55;

    // ---- Varsayilan stiller --------------------------------------
    node [fontname="Helvetica", fontsize=12, margin="0.18,0.10"];
    edge [fontname="Helvetica-Bold", fontsize=11, color="#5A6B80", arrowsize=0.9];

    // ---- Dugum siniflari -----------------------------------------
    // islem (process)
    node [shape=box, style="rounded,filled", fillcolor="#EAF4FB",
          color="#0077A8", fontcolor="#08344A"];
    P0 [label="Bolgedeki otobusler varis sirasina dizilir\l(en erken varan once islenir)\l"];
    P2 [label="ETA + en erken bos slot\l-> ideal varis zamani\l"];
    P3 [label="Bekleme suresi:  q = ideal - ETA"];

    // karar (decision) — eskenar dortgen
    node [shape=diamond, style="filled", fillcolor="#FFF6DC",
          color="#C79100", fontcolor="#5A4500", margin="0.05,0.05"];
    D1 [label="Otobus cok yakin mi?\n(etkin mesafe < 30 m)"];
    D2 [label="Slot bosalmadan\nmi gelecek?\n(ETA < ideal - 2 sn)"];
    D4 [label="Uzun bekleme mi?\n(q >= 2 sn)"];

    // KARAR (cost-benefit) — vurgulu
    node [shape=diamond, style="filled", fillcolor="#E1F7EE",
          color="#06A87C", fontcolor="#064C39", penwidth=2];
    D3 [label="KARAR\nTikanma yavaslamadan\npahali mi?\nnet = zincir + komsu - q > 0"];

    // cikis (no-op / DOKUNMA)
    node [shape=box, style="rounded,filled", fillcolor="#EEF1F5",
          color="#9AA7B5", fontcolor="#566373", penwidth=1];
    E1 [label="DOKUNMA\l'too_close' — komut yetismez\l"];
    E2 [label="DOKUNMA\l'on_time' — EN SIK durum\l"];
    E3 [label="DOKUNMA\l'queue_cheaper' — kisa bekleme ucuz\l"];

    // eylem (action)
    node [shape=box, style="rounded,filled", fillcolor="#06D6A0",
          color="#048A68", fontcolor="#053B2C", penwidth=2, fontsize=13];
    ACT [label="YAVASLA\nhiz bandi uret -> EMA ile yumusat ->\n\"60-70 km/h tut\" komutu sofore"];

    // ---- Omurga akisi --------------------------------------------
    P0 -> D1;
    D1 -> P2  [label="HAYIR"];
    P2 -> D2;
    D2 -> P3  [label="EVET (erken)"];
    P3 -> D3;
    D3 -> D4  [label="HAYIR"];
    D4 -> ACT [label="EVET", color="#06A87C", fontcolor="#06A87C", penwidth=1.6];

    // ---- KARAR kisa devresi (net>0 -> dogrudan yavasla) ----------
    D3 -> ACT [label="EVET", color="#06A87C", fontcolor="#06A87C",
               penwidth=1.6, constraint=false];

    // ---- Cikis (DOKUNMA) dallari ---------------------------------
    D1 -> E1 [label="EVET"];
    D2 -> E2 [label="HAYIR"];
    D4 -> E3 [label="HAYIR"];

    // ---- Hizalama: karar ve cikis kutulari ayni satirda ----------
    { rank=same; D1; E1; }
    { rank=same; D2; E2; }
    { rank=same; D4; E3; }
}
